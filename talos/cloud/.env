# Cloud-cluster settings for talstomize. Loaded automatically because it sits
# next to talstomize.yaml.

# renovate: datasource=github-releases depName=siderolabs/talos
CLOUD_TALOS_VERSION=v1.14.0
# renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
CLOUD_KUBE_VERSION=v1.37.0

# madbum's public address, and its address/subnet on the miroir private network.
CLOUD_NODE_IP=192.9.147.24
CLOUD_NODE_PRIVATE_IP=10.40.40.41
CLOUD_NODE_PRIVATE_SUBNET=10.40.40.0/24
CLOUD_NAMESERVER=1.1.1.1

# Cloud's own cluster CIDRs. Identical to home's today, but these are separate
# clusters -- they must not silently track globals.env's CLUSTER_*_CIDR.
CLOUD_POD_CIDR=172.16.0.0/16
CLOUD_SVC_CIDR=172.17.0.0/16
