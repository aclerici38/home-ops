{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      description: ["Track nix k3s version pin in raphael"],
      customType: "regex",
      managerFilePatterns: ["/(^|/)raphael/nixos/k3s\\.nix$/"],
      matchStrings: [
        // renovate: datasource=github-releases depName=k3s-io/k3s versioning=loose
        // k3sMinor = "1.34";
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+k3sMinor\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "{{{datasource}}}",
      versioningTemplate: "{{{versioning}}}",
      // Upstream tags are e.g. v1.36.2+k3s1; keep the pin minor-only. rc tags
      // are GitHub prereleases so ignoreUnstable (default) drops them.
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+)",
    },
    {
      description: ["Process various other dependencies"],
      customType: "regex",
      managerFilePatterns: ["!/^renovate\\//"],
      matchStrings: [
        // Example: `k3s_release_version: "v1.27.3+k3s1"` (general regex matcher).
        // Excludes '@' so digest-pinned values only match the pattern below.
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?"(?<currentValue>[^"@]*)"\n',
        // Example: `TZDATA_VERSION: "2026e@sha256:..."` (digest-pinned image tag)
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?"(?<currentValue>[^"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"\n',
        "(?m)datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?[\\s\\S]*?^\\s*\\S+\\s*[:=]\\s*(?<currentValue>\\S+)",
        // Example: `- https://github.com/rancher/system-upgrade-controller/releases/download/v0.11.0/crd.yaml` (e.g. kustomization.yaml lists)
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?-\\s(.*?)\/(?<currentValue>[^/]+)\/[^/]+\n",
        // for: apiVersion=helm.cattle.io/v1 kind=HelmChart
        "datasource=(?<datasource>\\S+)\n.*?repo: (?<registryUrl>\\S+)\n.*?chart: (?<depName>\\S+)\n.*?version: (?<currentValue>\\S+)\n",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Process Grafana CRD version field",
      managerFilePatterns: ["/grafana-operator/grafana/.*\\.ya?ml$/"],
      matchStrings: [
        "version:\\s*(?<depName>[^:]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      datasourceTemplate: "docker",
      autoReplaceStringTemplate: "version: {{{depName}}}:{{{newValue}}}@{{{newDigest}}}",
    },
    {
      customType: "regex",
      description: "Process yaml-language-server schema versions from GitHub tags URLs",
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "\\$schema=https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/refs/tags/(?<currentValue>[^/]+)/",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      customType: "regex",
      description: "Process yannh/kubernetes-json-schema versions",
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "\\$schema=https://raw\\.githubusercontent\\.com/yannh/kubernetes-json-schema/master/(?<currentValue>v[^-]+)-standalone-strict/",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/siderolabs/kubelet",
    },
    {
      // Every schema shares one constant depName so the automerge bundle's
      // dashboard line lists them as a single `k8s-versioned-schemas` entry
      // (the dashboard dedupes by depName). The schema name lives in depType,
      // which still shows per-row in the PR's "Type" column. This has to be
      // set at extraction: an overrideDepName packageRule would make the
      // post-replace re-extract see a different depName and fail the branch.
      customType: "regex",
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "k8s-versioned-schemas\\.pages\\.dev/(?<schema>[^/]+)/(?<currentValue>[^/]+)/",
        "\\?values=(?<schema>[^/]+)/(?<currentValue>[^\\s]+)",
        "aclerici38/k8s-versioned-schemas/crds/(?<schema>[^/]+)/(?<currentValue>[^/\\s'\"]+)",
      ],
      datasourceTemplate: "github-tags",
      depNameTemplate: "k8s-versioned-schemas",
      depTypeTemplate: "{{{schema}}}",
      packageNameTemplate: "aclerici38/k8s-versioned-schemas",
      extractVersionTemplate: "^{{{schema}}}/(?<version>.*)$",
    },
  ],
}
