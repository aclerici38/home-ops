{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  platformAutomerge: false,
  // Override the preset bundle's :automergeBranch back to PR-style automerge.
  automergeType: "pr",
  assignAutomerge: false,
  rebaseWhen: "conflicted",
  packageRules: [
    {
      description: ["Auto-merge GitHub Actions for minor and patch"],
      matchManagers: ["github-actions"],
      matchDatasources: ["github-tags"],
      automerge: true,
      matchUpdateTypes: ["minor", "patch"],
      schedule: ["* 2-6 * * *"],
    },
    {
      description: ["Auto-merge specific apps' minor versions"],
      automerge: true,
      matchDatasources: ["docker", "helm", "github-tags", "github-releases"],
      matchPackageNames: [
        "**/airconnect",
        "**/bazarr",
        "**/chromium",
        "**/cloudflare-ddns",
        "**/code-server",
        "**/collabora/code",
        "**/crowdsec-web-ui",
        "**/flaresolverr",
        //"**/flate",
        "**/grafana",
        "**/it-tools",
        "**/k8s-sidecar",
        "**/kube-prometheus-stack",
        "**/meilisearch",
        "**/omni-tools",
        "**/open-webui",
        "**/prowlarr",
        "**/prometheus-smartctl-exporter",
        "**/radarr",
        "**/renovate",
        "**/reloader",
        "**/searxng",
        "**/smartmontools",
        "**/sonarr",
        "**/talhelper",
        "**/tuppr",
        "**/zfs-scrubber",
      ],
      matchUpdateTypes: ["minor", "patch", "digest"],
      schedule: ["* 2-6 * * *"],
    },
    {
      description: ["Auto-merge specific apps' major versions"],
      automerge: true,
      matchDatasources: ["docker", "helm"],
      matchPackageNames: ["**/firefox"],
      matchUpdateTypes: ["major", "minor", "patch", "digest"],
      schedule: ["* 2-6 * * *"],
    },
    {
      description: ["Auto-merge specific patch updates"],
      automerge: true,
      matchPackageNames: [
        "**/echo",
        "**/gatus-sidecar",
        "**/konflate",
        "**/drm-exporter",
        "**/dawarich",
        "**/cert-manager"
      ],
      matchUpdateTypes: ["patch", "digest"],
      schedule: ["* 2-6 * * *"],
    },
    {
      description: ["Auto-merge specific digest-only updates"],
      automerge: true,
      matchPackageNames: [
        "ghcr.io/home-operations/**",
        "**/mbentley/omada-controller",
        "**/cloudnative-pg/charts/plugin-barman-cloud",
        "**/coredns",
      ],
      matchUpdateTypes: ["digest"],
      schedule: ["* 2-6 * * *"],
    },
    {
      description: ["Auto-merge haproxy, but only after a week"],
      automerge: true,
      matchDatasources: ["docker"],
      matchPackageNames: ["**/haproxy"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "7 days",
      schedule: ["* 2-6 * * *"],
    },
    {
      description: ["Auto-merge k8s-versioned-schemas"],
      automerge: true,
      matchDatasources: ["github-tags"],
      matchPackageNames: ["aclerici38/k8s-versioned-schemas"],
      matchUpdateTypes: ["major", "minor", "patch"],
    },
    {
      description: ["Auto-merge mise updates by default"],
      matchManagers: ["mise"],
      automerge: true,
      matchUpdateTypes: ["major", "minor", "patch", "digest"],
      schedule: ["* 2-6 * * *"],
    },
    {
      description: ["Exclude specific mise tools from auto-merge"],
      matchManagers: ["mise"],
      matchDepNames: [
        "cilium-cli",
        "kubectl",
        "github:cloudnative-pg/cloudnative-pg",
      ],
      automerge: false,
      schedule: ["at any time"],
    },
  ],
}
