{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // The built-in managers apply the preset's `registryAliases`
      // (mirror.gcr.io -> docker.io) at extract time, but custom regex managers
      // do not, so their deps are looked up against mirror.gcr.io itself.
      description: "Resolve mirror.gcr.io at Docker Hub for deps the custom managers extract",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^mirror\\.gcr\\.io\\//"],
      overridePackageName: "{{{replace 'mirror\\.gcr\\.io' 'docker.io' packageName}}}",
    },
    {
      description: ["Loose versioning for non-semver containers"],
      matchDatasources: ["docker"],
      matchPackageNames: ["/searxng/"],
      versioning: "loose",
    },
    {
      description: ["Custom versioning for calibre-web-automated (V)"],
      matchDatasources: ["docker"],
      matchPackageNames: ["/calibre-web-automated/"],
      versioning: "regex:^V(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: "Opencloud unzip web extension",
      matchDatasources: ["docker"],
      matchPackageNames: ["/opencloudeu/web-extensions/"],
      versioning: "regex:^unzip-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: "Vectorchord imageVolume pg extension (immich versioned)",
      matchDatasources: ["docker"],
      matchPackageNames: ["/tensorchord/vchord-scratch/"],
      matchFileNames: ["**/immich/**"],
      versioning: "regex:^pg18-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      // https://github.com/immich-app/immich/blob/main/server/src/constants.ts
      allowedVersions: "/^pg18-v1\\.\\d+\\.\\d+$/",
    },
    {
      description: "VectorChord CNPG extension (immich versioned)",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["/tensorchord/VectorChord/"],
      matchFileNames: ["**/immich/**"],
      allowedVersions: "/^1\\.\\d+\\.\\d+$/",
    },
    {
      description: "Frigate beta and RC",
      matchDatasources: ["docker"],
      matchPackageNames: ["/blakeblackshear/frigate/"],
      ignoreUnstable: false,
      respectLatest: false,
      versioning: "semver",
      matchFileNames: ["**/frigate/**"],
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+(?:-(?:beta\\d*|rc\\d*))?$/i",
    },
    {
      description: "Separate PRs for raphael, so the RV box updates independently of the clusters",
      matchFileNames: ["**/raphael/**"],
      // Keep specific groups in sync
      matchPackageNames: ["!/towonel-agent/", "!/siderolabs/kubelet/"],
      additionalBranchPrefix: "raphael-",
      commitMessageSuffix: "(raphael)",
      addLabels: ["raphael"],
    },
    {
      // Override renovate's k3s workaround
      description: "raphael k3s pin is minor-only; override the built-in k3s full-version workaround",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["k3s-io/k3s"],
      matchFileNames: ["**/raphael/**"],
      versioning: "loose",
    },
  ],
}
