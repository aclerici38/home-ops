{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // The built-in managers apply the preset's `registryAliases`
      // (mirror.gcr.io -> docker.io) at extract time, but custom regex managers
      // do not, so their deps are looked up against mirror.gcr.io itself.
      description: "Resolve mirror.gcr.io at Docker Hub for deps the custom managers extract",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^mirror\\.gcr\\.io\\//"],
      overridePackageName: "{{{replace 'mirror\\.gcr\\.io' 'docker.io' packageName}}}",
    },
    {
      // Digests are still pinned (pinDigest) and still move with every tag
      // bump; this only drops the "same tag, new digest" rebuild PRs.
      // The exceptions are re-enabled (and auto-merged) in autoMerge.json5.
      description: "No digest-only updates for images by default",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      enabled: false,
    },
    {
      description: ["Custom versioning for calibre-web-automated (V)"],
      matchDatasources: ["docker"],
      matchPackageNames: ["/calibre-web-automated/"],
      versioning: "regex:^V(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      // Tags are <chrome version>-r<image revision>, e.g. 154.0.8037.57-r1.
      // The anchored regex also skips the per-arch -amd64/-arm64 tags.
      description: "Custom versioning for karakeep-chrome (chrome version + revision)",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/karakeep-app/karakeep-chrome"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-r(?<revision>\\d+)$",
    },
    {
      description: "Opencloud unzip web extension",
      matchDatasources: ["docker"],
      matchPackageNames: ["/opencloudeu/web-extensions/"],
      versioning: "regex:^unzip-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: "Vectorchord imageVolume pg extension (immich versioned)",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/tensorchord/vchord-scratch"],
      // Both the catalog image and immich's Database version pin, so a release
      // immich can't use moves neither of them.
      matchFileNames: ["**/immich/**", "**/cloudnative-pg/catalogs/**"],
      // https://github.com/immich-app/immich/blob/main/server/src/constants.ts
      allowedVersions: "/^(?:pg18-v)?1\\.\\d+\\.\\d+$/",
    },
    {
      description: "Frigate beta and RC",
      matchDatasources: ["docker"],
      matchPackageNames: ["/blakeblackshear/frigate/"],
      ignoreUnstable: false,
      respectLatest: false,
      versioning: "semver",
      matchFileNames: ["**/frigate/**"],
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+(?:-(?:beta\\d*|rc\\d*))?$/i",
    },
    {
      description: "Track talstomize prereleases for now",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["mirceanton/talstomize"],
      versioning: "semver",
      ignoreUnstable: false,
      respectLatest: false,
    },
    {
      description: "Let a release's assets settle before mise locks them",
      matchManagers: ["mise"],
      minimumReleaseAge: "1 day",
    },
    {
      description: "Separate PRs for raphael, so the RV box updates independently of the clusters",
      matchFileNames: ["**/raphael/**"],
      // Keep specific groups in sync
      matchPackageNames: ["!/towonel-agent/", "!/siderolabs/kubelet/"],
      // Auto-merged updates still join the nightly bundle: autoMerge.json5 is
      // extended after this file and resets the prefix to "".
      additionalBranchPrefix: "raphael-",
      commitMessageSuffix: "(raphael)",
      addLabels: ["raphael"],
    },
    {
      // Override renovate's k3s workaround
      description: "raphael k3s pin is minor-only; override the built-in k3s full-version workaround",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["k3s-io/k3s"],
      matchFileNames: ["**/raphael/**"],
      versioning: "loose",
      rebaseWhen: "behind-base-branch",
    },
  ],
}
