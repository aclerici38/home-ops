{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // Default grouping: bundle any deps that share a package "basename"
      // (the last path segment of depName) across managers/datasources. This
      // auto-groups a k8s-versioned-schemas CRD (depName e.g. "multus") with
      // its upstream chart/image (e.g. ghcr.io/home-operations/charts/multus) without
      // an explicit per-app rule. Explicit groups below override this where a
      // bundle must span differently-named packages (e.g. Talos, Kgateway).
      description: "Group by package basename (schema <-> upstream)",
      matchDatasources: ["docker", "helm", "github-tags", "github-releases"],
      groupName: "{{ replace '.+/' '' depName }}",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Require an upstream sibling before grouping a schema",
      matchPackageNames: ["aclerici38/k8s-versioned-schemas"],
      groupName: "{{ replace '.+/' '' depName }}",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Mise tools group",
      groupName: "Mise tools",
      matchManagers: ["mise"],
      matchDepNames: [
        "!cilium-cli",
        "!kubectl",
        "!talosctl",
        "!talhelper",
        "!github:cloudnative-pg/cloudnative-pg",
      ],
      separateMajorMinor: false,
      separateMinorPatch: false,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Cilium group",
      groupName: "cilium",
      matchPackageNames: ["/cilium/"],
      minimumGroupSize: 2,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Omada-Controller Group",
      groupName: "Omada-Controller",
      matchPackageNames: ["/omada-controller/", "/omada-controller-helm/"],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Towonel Group",
      groupName: "Towonel",
      matchPackageNames: ["/towonel-agent/", "/towonel-node/"],
      matchDatasources: ["docker"],
      minimumGroupSize: 2,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Envoy AI Gateway Group",
      groupName: "Envoy AI Gateway",
      matchPackageNames: ["/ai-gateway-helm/", "/ai-gateway-crds-helm/"],
      matchDatasources: ["docker"],
      minimumGroupSize: 2,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Kgateway Group",
      groupName: "kgateway",
      matchPackageNames: ["/kgateway-dev/", "/^kgateway$/"],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Opencloud Group",
      groupName: "Opencloud",
      matchPackageNames: ["/opencloudeu/"],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Flux Operator Group",
      groupName: "Flux Operator",
      matchPackageNames: [
        "/flux-operator/",
        "/flux-instance/",
        "/controlplaneio-fluxcd/charts/",
        "/^flux$/",
      ],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Intel-Device-Plugins Group",
      groupName: "Intel Device Plugins",
      matchPackageNames: ["/intel-device-plugins/"],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Talos (home)",
      groupName: "Talos (home)",
      matchPackageNames: ["**/siderolabs/talos", "**/siderolabs/talosctl"],
      matchFileNames: ["globals.env"],
      additionalBranchPrefix: "home-",
      // Override separateMinorPatch inherited from the Mise tools group
      separateMinorPatch: false,
      commitMessageSuffix: "(home)",
      group: {
        commitMessageTopic: "Talos group",
      },
    },
    {
      // Cloud cluster Talos version separate.
      description: "Talos (cloud)",
      groupName: "Talos (cloud)",
      matchPackageNames: ["**/siderolabs/talos", "**/siderolabs/talosctl"],
      matchFileNames: ["talos/cloud/**", "kubernetes/flux/cloud/**"],
      additionalBranchPrefix: "cloud-",
      separateMinorPatch: false,
      commitMessageSuffix: "(cloud)",
      group: {
        commitMessageTopic: "Talos group",
      },
    },
    {
      description: "Immich Group",
      groupName: "Immich",
      matchPackageNames: ["/immich-app/"],
      matchDatasources: ["docker", "github-releases"],
      // Allow rc prereleases and openvino
      versioning: "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<prerelease>rc\\.\\d+))?(?:-(?<compatibility>openvino))?$",
      ignoreUnstable: false,
      respectLatest: false,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Coredns group",
      groupName: "Coredns",
      matchPackageNames: ["/coredns/"],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "1Pass group",
      groupName: "1Pass",
      matchPackageNames: ["/1password/"],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Rook-Ceph group",
      groupName: "Rook-Ceph",
      matchPackageNames: ["/rook/"],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // ceph-csi-drivers is CRs/RBAC for the ceph-csi-operator that the
      // rook-ceph chart vendors as a subchart, so it must never run ahead of
      // the version pinned in that chart's Chart.yaml. Joining the Rook-Ceph
      // group with minimumGroupSize set ONLY here makes the gate asymmetric:
      // the branch value is the max across the upgrades actually in it, so a
      // csi-drivers-only branch resolves to 3 and is skipped, while a
      // rook-only branch resolves to 2 and opens as usual. Still verify the
      // vendored version on the grouped PR:
      //   helm show chart oci://ghcr.io/rook/rook-ceph --version <new> \
      //     | yq '.dependencies[] | select(.name=="ceph-csi-operator").version'
      description: "Tie ceph-csi-drivers to its rook chart",
      groupName: "Rook-Ceph",
      matchPackageNames: ["ceph-csi-drivers"],
      matchDatasources: ["helm"],
      minimumGroupSize: 3,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "CNPG Postgres Containers group",
      groupName: "CNPG-postgres-containers",
      matchPackageNames: ["/cloudnative-pg/postgresql/"],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Streamystats group",
      groupName: "Streamystats",
      matchPackageNames: ["/streamystats-nextjs/", "/streamystats-job-server/"],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Vectorchord Group",
      groupName: "Vectorchord",
      matchPackageNames: ["/VectorChord/", "/vchord-scratch/"],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Pocket-ID group",
      groupName: "Pocket-ID",
      matchPackageNames: ["/pocket-id/"],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Kube-Prometheus-Stack group",
      groupName: "Kube-Prometheus-Stack",
      matchPackageNames: ["/kube-prometheus-stack/"],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Snapshot-Controller group",
      groupName: "Snapshot-Controller",
      matchPackageNames: ["/snapshot-controller/"],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Dragonfly-Operator group",
      groupName: "Dragonfly-Operator",
      matchPackageNames: ["/dragonfly-operator/"],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "KEDA group",
      groupName: "KEDA",
      matchPackageNames: ["/keda/"],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Volsync group",
      groupName: "Volsync",
      matchPackageNames: ["/perfectra1n-volsync/", "/perfectra1n/volsync/"],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Flate group",
      groupName: "Flate",
      matchPackageNames: ["/home-operations/flate/"],
      matchDatasources: ["github-releases", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Nix flake inputs",
      matchManagers: ["nix"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "raphael flake",
      groupName: "Nix Flake (raphael)",
      groupSlug: "raphael",
      matchManagers: ["nix"],
      matchFileNames: ["raphael/**"],
      addLabels: ["raphael"],
      lockFileMaintenance: {
        automerge: false,
        commitMessageAction: "Refresh",
        commitMessageTopic: "nix flake inputs (raphael)",
      },
    },
    {
      description: "Nodejs-Poolcontroller group",
      groupName: "nodejs-poolcontroller",
      matchPackageNames: ["/tagyoureit/njspc/", "/rstrouse/njspc-dash/"],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes group",
      groupName: "Kubernetes",
      matchPackageNames: ["kubernetes/kubernetes", "ghcr.io/siderolabs/kubelet"],
      minimumGroupSize: 2,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      // code-server is a sidecar in both home-assistant pods, so bumping it
      // alone restarts Home Assistant for a change HA doesn't care about.
      // Overriding the basename default puts it in the "home-assistant" group,
      // and minimumGroupSize is set ONLY here: the branch value is the max
      // across the upgrades actually in that branch, so a code-server-only
      // branch resolves to 2 and is skipped, while a home-assistant-only
      // branch resolves to 1 and opens as usual. Skipped branches are listed
      // under "Group Size Not Met" on the dashboard if one is worth forcing.
      description: "Tie code-server to its home-assistant sidecar host",
      groupName: "home-assistant",
      matchPackageNames: ["**/code-server"],
      matchDatasources: ["docker"],
      minimumGroupSize: 2,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
  ],
}
