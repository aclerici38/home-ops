#!/usr/bin/env bash
#MISE description="Hand Homebrew-installed casks over to mise without reinstalling them"
#
# mise refuses any cask Homebrew owns, and ownership is decided by one thing:
# the presence of $HOMEBREW_PREFIX/Caskroom/<token>/.metadata. Moving that file
# aside lets mise adopt the existing bundle in place instead of reinstalling it,
# which is what preserves the macOS Privacy & Security grants.
#
# Nothing is deleted: .metadata is moved to a backup and restored if mise fails.
#
#   mise run macos:migrate-casks --list
#   mise run macos:migrate-casks vlc
#   mise run macos:migrate-casks --all
#   mise run macos:migrate-casks --restore vlc

set -euo pipefail

REPO="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
export MISE_GLOBAL_CONFIG_FILE="$REPO/.mise.toml"
PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
CASKROOM="$PREFIX/Caskroom"
BACKUP="$REPO/.private/cask-metadata-backup"

# Pkg-only casks: no app bundle exists to adopt, so mise runs the vendor .pkg.
# User data survives (pkg installers do not remove it) but permissions reset.
PKG_ONLY=" opencloud zoom "

casks() {
  grep -oE '^"brew-cask:[^"]+"' "$MISE_GLOBAL_CONFIG_FILE" | sed 's/^"brew-cask://; s/"$//'
}

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!! \033[0m %s\n' "$*" >&2; }
err() { printf '\033[1;31mxx \033[0m %s\n' "$*" >&2; }

migrate_one() {
  local token="$1" meta="$CASKROOM/$1/.metadata" moved=0

  if [[ "$PKG_ONLY" == *" $token "* ]]; then
    warn "$token is a pkg-only cask — mise will run the vendor installer, not adopt."
    warn "    Data is preserved, but you will need to re-grant its permissions."
    read -rp "    Continue with $token? [y/N] " reply
    [[ "$reply" == [yY] ]] || {
      log "skipped $token"
      return 0
    }
  fi

  if [[ -e "$meta" ]]; then
    mkdir -p "$BACKUP/$token"
    log "$token: moving Homebrew .metadata aside"
    mv "$meta" "$BACKUP/$token/.metadata"
    moved=1
  else
    log "$token: no Homebrew .metadata (already handed over)"
  fi

  if mise bootstrap packages apply --yes "brew-cask:$token"; then
    log "$token: migrated"
    return 0
  fi

  err "$token: mise failed"
  if ((moved)); then
    warn "$token: restoring Homebrew .metadata — Homebrew owns it again"
    mv "$BACKUP/$token/.metadata" "$meta"
    rmdir "$BACKUP/$token" 2> /dev/null || true
  fi
  return 1
}

restore_one() {
  local token="$1" src="$BACKUP/$1/.metadata"
  [[ -e "$src" ]] || {
    err "$token: no backup at $src"
    return 1
  }
  mkdir -p "$CASKROOM/$token"
  mv "$src" "$CASKROOM/$token/.metadata"
  rmdir "$BACKUP/$token" 2> /dev/null || true
  log "$token: handed back to Homebrew"
}

case "${1:---list}" in
  --list)
    printf '%-26s %-12s %s\n' CASK OWNER NOTE
    while read -r c; do
      owner="mise/none"
      [[ -e "$CASKROOM/$c/.metadata" ]] && owner="homebrew"
      note=""
      [[ "$PKG_ONLY" == *" $c "* ]] && note="pkg-only: will reinstall"
      printf '%-26s %-12s %s\n' "$c" "$owner" "$note"
    done < <(casks)
    ;;
  --all)
    failed=()
    while read -r c; do migrate_one "$c" || failed+=("$c"); done < <(casks)
    ((${#failed[@]})) && {
      err "failed: ${failed[*]}"
      exit 1
    }
    log "all casks migrated"
    ;;
  --restore)
    shift
    [[ $# -gt 0 ]] || {
      err "--restore needs a cask name"
      exit 1
    }
    for c in "$@"; do restore_one "$c"; done
    ;;
  *)
    for c in "$@"; do migrate_one "$c"; done
    ;;
esac
