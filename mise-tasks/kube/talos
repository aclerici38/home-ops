#!/usr/bin/env bash
#MISE description="Render a Talos cluster's talosconfig and merge its kubeconfig into ~/.kube/config"
#MISE dir="talos"
#USAGE arg "<cluster>" help="which Talos cluster" {
#USAGE   choices "home" "cloud"
#USAGE }
set -euo pipefail
# For a fresh machine: needs only age.key. talstomize decrypts the cluster's
# secrets bundle into a talosconfig, which then fetches an admin kubeconfig.
cluster="$usage_cluster"
talosconfig="$PWD/$cluster/clusterconfig/talosconfig"

echo "==> rendering $cluster talosconfig"
mise run talos:gen "$cluster"
chmod 600 "$cluster"/clusterconfig/*

# shellcheck disable=SC2016 # $c is a yq variable
node="$(yq '.context as $c | .contexts[$c].endpoints[0]' "$talosconfig")"
echo "==> fetching kubeconfig from $node"
mkdir -p "$HOME/.kube"
# --force replaces this cluster's context in place rather than prompting
talosctl --talosconfig "$talosconfig" --nodes "$node" kubeconfig --force
chmod 600 "$HOME/.kube/config"
echo "==> current context: $(kubectl config current-context)"
