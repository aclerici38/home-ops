#!/usr/bin/env bash
#MISE description="Regenerate secrets.env.json from 1Password (gitignored; run once per machine)"
set -euo pipefail
# Piped end to end so the plaintext token never lands on disk. The encrypted
# result is deliberately NOT committed: it is a github.com credential, and the
# reproducible artifact is this command, not the file.
out="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}/secrets.env.json"
op read "op://kubernetes/GITHUB_TOKEN/token" \
  | jq -Rn '{GITHUB_TOKEN: input}' \
  | sops encrypt --input-type json --output-type json /dev/stdin > "$out"
chmod 600 "$out"
echo "wrote $out ($(jq -r '.sops.age[0].recipient' "$out"))"
