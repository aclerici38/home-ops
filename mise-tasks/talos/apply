#!/usr/bin/env bash
#MISE description="Apply Talos config to a cluster, or a single node"
#MISE dir="talos"
#MISE confirm="Apply Talos machine config? This can roll nodes."
#USAGE arg "<cluster>" help="which Talos cluster" {
#USAGE   choices "home" "cloud"
#USAGE }
#USAGE arg "[node]" help="limit to one node (default: all)"
set -euo pipefail
cd "$usage_cluster"

# talstomize shells out to a bare `talosctl`, so it inherits TALOSCONFIG from the environment
export TALOSCONFIG="$PWD/clusterconfig/talosconfig"

if [[ ! -f "$TALOSCONFIG" ]]; then
  echo "ERROR: $TALOSCONFIG missing. Run 'mise run talos:gen $usage_cluster' first."
  exit 1
fi

# `talstomize diff` compares the rendered config against live cluster state --
# running machine config, booted Talos version, installed extensions and kernel
# args -- and exits 1 on any drift. Show it before touching anything.
if [[ -n "${usage_node:-}" ]]; then
  talstomize diff -f . --node "$usage_node" || true
  talstomize apply -f . --node "$usage_node"
else
  talstomize diff -f . || true
  talstomize apply -f .
fi
